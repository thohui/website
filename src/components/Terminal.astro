---
import { ABOUT, CONTACT_LINKS, SKILLS } from "@/lib/profile";
import { ONGOING_PROJECTS } from "@/lib/projects";
import type { TerminalData } from "@/lib/terminal/types";

const data: TerminalData = {
  about: ABOUT,
  skills: SKILLS,
  projects: ONGOING_PROJECTS,
  contact: CONTACT_LINKS,
};

const payload = JSON.stringify(data).replace(/</g, "\\u003c");
---

<div
  id="terminal"
  class="terminal"
  role="dialog"
  aria-modal="true"
  aria-label="Terminal"
  aria-hidden="true"
  hidden
>
  <div class="terminal-header">
    <button type="button" data-terminal-close aria-label="Close terminal">
      esc
    </button>
  </div>

  <div class="terminal-body" data-terminal-body>
    <div data-terminal-output></div>
    <div class="terminal-line" data-terminal-line>
      <span class="t-prompt">visitor@thohui:~$</span>
      <span class="terminal-mirror" data-terminal-mirror></span>
      <input
        type="text"
        data-terminal-input
        aria-label="Terminal input"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="go"
      />
    </div>
  </div>
</div>

<script is:inline type="application/json" data-terminal-data set:html={payload} />

<style is:global>
  .terminal {
    --term-bg: #121416;
    --term-text: #b8bcc2;
    --term-bright: #dcdfe4;
    --term-dim: #5c6370;
    --term-accent: #7cc47c;
    --term-error: #e08a76;
    --term-border: #3a3f45;

    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    background-color: var(--term-bg);
    color: var(--term-text);
    font-family: "IBM Plex Mono", "Courier New", monospace;
    font-size: 0.875rem;
    line-height: 1.7;
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  :root[data-theme="light"] .terminal {
    --term-bg: #fbfbfa;
    --term-text: #4a4e54;
    --term-bright: #1a1c1e;
    --term-dim: #8b9099;
    --term-accent: #2f7d32;
    --term-error: #b0412a;
    --term-border: #d5d6d4;
  }

  .terminal[hidden] {
    display: none;
  }

  .terminal.open {
    opacity: 1;
  }

  .terminal::after {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      var(--term-bright) 0 1px,
      transparent 1px 3px
    );
    opacity: 0.025;
    pointer-events: none;
    z-index: 2;
  }

  html.terminal-open,
  html.terminal-open body {
    overflow: hidden;
  }

  .terminal-header {
    flex: none;
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem 1.5rem;
  }

  .terminal-title {
    color: var(--term-dim);
  }

  .terminal-header button {
    font: inherit;
    color: var(--term-text);
    background-color: transparent;
    border: 1px solid var(--term-border);
    padding: 0.4rem 0.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .terminal-header button:hover {
    color: var(--term-bg);
    background-color: var(--term-text);
    border-color: var(--term-text);
  }

  .terminal-body {
    flex: 1;
    overflow-y: auto;
    overflow-x: auto;
    padding: 0 1rem 2rem;
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
    scrollbar-width: thin;
    scrollbar-color: var(--term-border) transparent;
  }

  .terminal .t-line {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    min-height: 1.7em;
  }

  .terminal .t-echo {
    color: var(--term-bright);
  }

  .terminal .t-prompt {
    color: var(--term-accent);
  }

  .terminal .t-prefix,
  .terminal .t-key,
  .terminal .t-dim {
    color: var(--term-dim);
  }

  .terminal .t-fetch {
    white-space: pre;
    overflow-wrap: normal;
  }

  .terminal .t-reso {
    color: #ff0076;
  }

  .terminal .t-bold {
    font-weight: 500;
  }

  .terminal .t-bright {
    color: var(--term-bright);
  }

  .terminal .t-accent {
    color: var(--term-accent);
  }

  .terminal .t-error {
    color: var(--term-error);
  }

  .terminal a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .terminal a:hover {
    color: var(--term-bg);
    background-color: var(--term-accent);
    text-decoration: none;
  }

  .terminal-line {
    position: relative;
    display: flex;
    gap: 0.5ch;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .terminal-mirror {
    flex: 1;
    min-width: 0;
  }

  .terminal-line input {
    position: absolute;
    inset: 0;
    width: 100%;
    border: none;
    padding: 0;
    font: inherit;
    color: transparent;
    background: transparent;
    caret-color: transparent;
    outline: none;
  }

  .terminal .t-caret {
    background-color: var(--term-accent);
    color: var(--term-bg);
    animation: terminal-blink 1.1s steps(1) infinite;
  }

  .terminal-mirror:has(~ input:not(:focus)) .t-caret {
    animation: none;
    background-color: transparent;
    outline: 1px solid var(--term-dim);
    outline-offset: -1px;
    color: inherit;
  }

  @keyframes terminal-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal {
      transition: none;
    }
    .terminal .t-caret {
      animation: none;
    }
  }

  @media (max-width: 600px) {
    .terminal {
      font-size: 0.8125rem;
    }
    .terminal-header {
      gap: 1rem;
      padding: 1rem 0.5rem;
    }
    .terminal-body {
      padding: 0 0.5rem 1rem;
    }
  }
</style>

<script>
  import { mountTerminal } from "@/lib/terminal/terminal";
  import { watchTriggers } from "@/lib/terminal/triggers";
  import type { TerminalData } from "@/lib/terminal/types";

  const root = document.getElementById("terminal");
  const payload = document.querySelector("[data-terminal-data]");

  if (root && payload?.textContent) {
    const data = JSON.parse(payload.textContent) as TerminalData;
    const terminal = mountTerminal(root, data);

    root
      .querySelector("[data-terminal-close]")
      ?.addEventListener("click", () => terminal.close());

    watchTriggers(() => {
      if (!terminal.isOpen()) terminal.open();
    });
  }
</script>

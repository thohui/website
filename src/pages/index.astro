---
import { ONGOING_PROJECTS } from "@/lib/projects";
import { ABOUT, SKILLS } from "@/lib/profile";
import Layout from "../layouts/Layout.astro";
import Project from "@/components/Project.astro";
---

<Layout>
  <section class="intro">
    <h1 class="title">Thomas Huisman</h1>
    <p class="subtitle">Software Engineer</p>
  </section>

  <section class="about">
    <h2 class="title">about me</h2>
    {ABOUT.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section class="projects">
    <h2 class="title">ongoing projects</h2>
    {
      ONGOING_PROJECTS.map((project) => (
        <Project
          title={project.title}
          description={project.description}
          url={project.url}
          technologies={project.technologies}
        />
      ))
    }
    <p style="padding-top: 1em;">
      For a more complete overview of my work, check out my github profile <a
        href="https://github.com/thohui"
        target="_blank"
        aria-label="GitHub profile"
        rel="noopener">here</a
      >.
    </p>
  </section>

  <section class="skills">
    <h2 class="title">skills</h2>
    <ul class="skills-list">
      {SKILLS.map((skill) => <li>{skill}</li>)}
    </ul>
  </section>
</Layout>

<style>
  .intro {
    margin-bottom: 3rem;
  }

  .title {
    color: var(--text-bright);
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--text-dim);
    margin-bottom: 0;
  }

  .skills-list {
    color: var(--text);
  }

  section {
    margin-bottom: 2.5rem;
  }
</style>
